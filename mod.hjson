#the mod name as displayed in-game
displayName: "Grounded Industry"

#the internal name of your mod
name: "grounded-industry"

author: "PlaguePhreak"

#the fully qualified main class of the mod
main: "grounded.GroundedIndustry"

description: "Engineering realism for Mindustry. Power is lost over long transmission lines, overloaded grids trip breakers, generators take time to spin up, hot machines need cooling, and long pipelines lose pressure. More systems (steelmaking, ammo logistics) to come. Every mechanic can be toggled in Settings > Grounded Industry."

version: 0.4.0

#the minimum game build required to run this mod
minGameVersion: 160.3

java: true

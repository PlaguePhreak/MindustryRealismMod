#the mod name as displayed in-game
displayName: "Grounded Industry"

#the internal name of your mod
name: "grounded-industry"

author: "PlaguePhreak"

#the fully qualified main class of the mod
main: "grounded.GroundedIndustry"

description: "Engineering realism for Mindustry. Power is lost over long transmission lines, overloaded grids trip breakers, generators take time to spin up, hot machines need cooling, long pipelines lose pressure, and turrets reload magazines and overheat. More systems (steelmaking, Hard Realism) to come. Every mechanic can be toggled in Settings > Grounded Industry."

version: 0.5.0

#the minimum game build required to run this mod
minGameVersion: 160.3

java: true
